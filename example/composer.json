{
    "name": "phplti/lti1p3-example",
    "description": "Example tool built on phplti/lti1p3, with a bundled platform simulator for local end-to-end testing without a live Brightspace tenant.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": ".."
        }
    ],
    "require": {
        "php": "^8.1",
        "phplti/lti1p3": "dev-main",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "guzzlehttp/guzzle": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "PhpLti\\Lti1p3Example\\": "src/",
            "PhpLti\\Lti1p3Example\\Simulator\\": "simulator/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
