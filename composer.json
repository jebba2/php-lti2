{
    "name": "phplti/lti1p3",
    "description": "LTI 1.3 Advantage tool-side backend library (OIDC launch, Deep Linking, AGS, NRPS), framework-agnostic via PSR-7/15/16/17/18.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-client": "^1.0",
        "psr/simple-cache": "^3.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "guzzlehttp/guzzle": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "PhpLti\\Lti1p3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpLti\\Lti1p3\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/generate-keypair.php"
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
